<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_pricelist_tree_ext" model="ir.ui.view">
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="ppi_sequence" widget="handle" />
            </xpath>
        </field>
    </record>

    <record id="product_pricelist_item_ext" model="ir.ui.view">
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='item_ids']/tree/field[@name='name']"
                position="before"
                >
                  <field name="ppi_sequence" widget="handle" />
            </xpath>
            <xpath expr="//field[@name='item_ids']/tree" position="attributes">
                <attribute name="default_order">ppi_sequence</attribute>
            </xpath>
        </field>
    </record>
</odoo>
